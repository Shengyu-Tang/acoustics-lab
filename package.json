{
  "name": "acoustics-lab",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174",
    "build": "tsc --noEmit && tsc --project backend/tsconfig.json && vite build && node scripts/inline-build.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4174",
    "api:dev": "wrangler dev --config backend/wrangler.jsonc --port 8787",
    "api:deploy": "wrangler deploy --config backend/wrangler.jsonc",
    "test": "node --experimental-strip-types scripts/check-physics.mjs"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/node": "22.19.19",
    "@cloudflare/workers-types": "4.20260515.1",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  }
}